' ================================================================
' ANALYSIS CLUSTER
' ================================================================
class analysis {
  + id, name, description
  + metric : char = 'geo_euclidean'
  + embedding : char = 'cmds'
  + projectionDimensionality : double = 2
  + subjectsIncluded, sessionsIncluded : double[]
  + channelGrouping : double[]
  + signalDescriptors : double[Mx2]
  - runStatus : logical
  - F : experimentSpace
  - H : double[]
  - I : double[Nx5]
  - Y : double[Nx2]
  - D : double[]
  - clusters : cell
  + /nPatterns, nClusters <<Dep>>
  __
  + run()
  + addCluster / removeCluster / getCluster
  + findCluster / clearClusters
  + createCluster()
  + kmeans()
  + dist2 / emd / emd_calculateCosts
  + mena_embedding / mena_geodesic / mena_metric
  + mena_getGroundCosts
  + ic_jsm / ic_pdist
  .. deprecation: v1.5.5 ..
}

class experimentSpace {
  + id, name, description
  + sessionNames : struct[]
  + performAveraging : logical = false
  + performResampling : logical = false
  + performFixWindow : logical = true <<DEPRECATED>>
  + performNormalization : logical = false
  + baselineSamples : double = 15
  + restSamples : double = -1
  + rsBaseline, rsTask, rsRest : double
  + fwOnset, fwDuration, fwBreakDelay : double
  + normalizationMethod : char = 'normal'
  + normalizationScope : char = 'collective'
  + normalizationDimension : char = 'combined'
  - runStatus : logical
  - Fvectors : cell
  - Findex : double[Nx8]
  + /nPoints <<Dep>>
  __
  + compute()
  + getSubset(...)
  + normalize()
  + setVectors(...)
  .. deprecation: v1.5.5 ..
}

class cluster {
  + id : double
  + tag : char = 'Cluster0001'
  + description : char
  + patternIndexes : double[]
  + visible : logical = true
  + subjectIDs, sessionIDs : double[]
  + stimulusIDs, blockIDs, channelGroupIDs : double[]
  + centroid : double[]
  + furthestPoint : double[]
  + averageDistance, maximumDistance : double
  + /nPatterns <<Dep>>
  __
  + (visualization properties:
  + showPatternPoints, showCentroid,
  + showFurthestPoint, showLink,
  + dataMarker/Color, centroidMarker/Color)
  .. deprecation: v1.5.5 ..
}

