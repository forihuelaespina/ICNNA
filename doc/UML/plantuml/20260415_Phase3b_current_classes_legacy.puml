  + addSubregion / removeSubregion / getSubregion
  + getNSubregions / getNVertexes
  + checkPoint(x, y) : logical
  .. deprecation: review at v1.5.5 ..
  .. (P3b.4: disposition pending) ..
}

abstract class menaGrid <<abstract>> {
  - id : double
  - lineWidth : double = 1.5
  - edgeColor : double[1x3]
  - highlightCells : double[]
  - highlightEdgeColor, highlightFaceColor : double[1x3]
  - highlightFaceAlpha : double = 1
  - labelCells : logical = false
  - vertexVisible : logical = false
  - vertexColor : double[1x3]
  - vertexMarker : char = '.'
  - vertexMarkerSize : double = 8
  __
  + {abstract} getNCells()
  + {abstract} getCellCenter(idx)
  + {abstract} getPolygon(idx)
  + {abstract} inWhichCells(points)
  + {abstract} gridCell2ind / ind2gridCell
  + {abstract} plot()
  .. deprecation: review at v1.5.5 ..
  .. (P3b.4: disposition pending) ..
}

class logarithmicRadialGrid {
  - minR : double = 10
  - maxR : double = 1000
  - nRings : double = 5
  - nAngles : double = 12
  + /r, th <<Dep>>
  __
  + createGrid()
  + getNCells / getCellCenter / getPolygon
  + inWhichCells(points)
  + gridCell2ind / ind2gridCell
  + plot()
  .. deprecation: review at v1.5.5 ..
  .. (P3b.4: disposition pending) ..
}


' ================================================================
' INHERITANCE
' ================================================================
neuroimage           --|> structuredData
nirs_neuroimage      --|> neuroimage
ecg                  --|> structuredData
rawData_ETG4000      --|> rawData
rawData_NIRScout     --|> rawData
rawData_Snirf        --|> rawData
rawData_ShimadzuLabnirs --|> rawData
rawData_UCLWireless  --|> rawData
rawData_BioHarnessECG --|> rawData
rawData_LSL          --|> rawData
logarithmicRadialGrid --|> menaGrid

' ================================================================
' COMPOSITION / AGGREGATION
' ================================================================
experiment           *-- "0..*" dataSourceDefinition : dataSourceDefinitions
experiment           *-- "0..*" sessionDefinition    : sessionDefinitions
experiment           *-- "0..*" subject              : subjects
subject              *-- "0..*" session              : sessions
session              *-- "1"    sessionDefinition    : definition
session              *-- "0..*" dataSource           : sources
sessionDefinition    *-- "0..*" dataSourceDefinition : sources
dataSource           *-- "1"    rawData              : rawData
dataSource           *-- "0..*" structuredData       : structured
neuroimage           *-- "1"    channelLocationMap   : chLocationMap
analysis             *-- "1"    experimentSpace      : F
analysis             *-- "0..*" cluster              : clusters
imagePartition       *-- "0..*" roi                  : rois
structuredData       *-- "1"    integrityStatus      : integrity

' ================================================================
' CROSS-ARCHITECTURE DEPENDENCIES
' ================================================================
structuredData       *-- "1" m_timeline : "timeline\n(modern class)"
rawData_Snirf        *-- "1" m_snirf    : snirfImg

' ================================================================
' LEGEND
' ================================================================
legend bottom left
  |= Colour |= Meaning |
  | <#Wheat> | Legacy class (src/oo/) |
  | <#White> | Modern class stub (src/+icnna/) |
  ..
  Deprecation version shown per class.
  All oo/ classes deleted at v1.8.0.
  .mat load-compat adapters retained
  past v1.8.0; final removal at v2.0.0.
end legend

