@startuml ICNNA_v141beta_classes_legacy
' ============================================================
' ICNNA v1.4.1-beta — Legacy class diagram
' Scope: src/oo/  (29 classes)
' Companion: ICNNA_v141beta_classes_modern (+icnna.data.core)
' Phase 3b.1 deliverable (revised 2026-04-19)
' ============================================================
' Conventions:
'   - Triangle (--|>): inheritance
'   - Filled diamond (*--): composition
'   - Open diamond (o--): aggregation
'   - Dashed (..>): dependency / cross-architecture ref
'   - All legacy classes coloured wheat
'   - Deprecation version shown per class
'   - Trivial get/set accessors omitted for readability
' ============================================================

skinparam classAttributeIconSize 0
skinparam linetype polyline
skinparam nodesep 25
skinparam ranksep 30
skinparam dpi 150

skinparam class {
  BackgroundColor Wheat
  BorderColor DarkGoldenRod
}

title src/oo/  —  Legacy Classes (v1.4.1-beta)\n29 classes; scheduled for deletion at v1.8.0 (Arc D)

' ================================================================
' CROSS-ARCHITECTURE STUBS (from +icnna.data.core)
' These are NOT legacy; shown here as reference points only.
' ================================================================
class "icnna.data.core.timeline" as m_timeline <<modern>> #White {
  (see modern spine diagram)
}

class "icnna.data.snirf.snirf" as m_snirf <<modern>> #White {
  (see +icnna.data.snirf)
}

' ================================================================
' EXPERIMENTAL MODEL
' ================================================================
class experiment {
  + name : char = 'NewExperiment'
  + description : char
  + studyDate : datetime
  - dataSourceDefinitions : cell
  - sessionDefinitions : cell
  - subjects : cell
  + /nDataSourceDefinitions <<Dep>>
  + /nSessionDefinitions <<Dep>>
  + /nSubjects <<Dep>>
  __
  + addSubject / removeSubject / getSubject
  + addSessionDefinition / removeSessionDefinition
  + addDataSourceDefinition / removeDataSourceDefinition
  + merge(exp)
  .. deprecation: v1.4.7b ..
}

class subject {
  + id : double
  + name : char = 'Subj0001'
  + age : double
  + sex : char = 'U'
  + hand : char = 'U'
  - sessions : cell
  + /nSessions <<Dep>>
  __
  + addSession / removeSession / getSession
  + findSession / clearSessions
  + checkIntegrity()
  .. deprecation: v1.4.7b ..
}

class session {
  + definition : sessionDefinition
  + date : datenum
  - sources : cell
  + /nDataSources <<Dep>>
  __
  + addDataSource / removeDataSource
  + getDataSource / findDataSource
  + clearDataSources
  .. deprecation: v1.4.7b ..
}

class sessionDefinition {
  + id : double
  + name : char = 'Session0001'
  + description : char
  - sources : cell
  + /nDataSources <<Dep>>
  __
  + addSource / removeSource / getSource
  + findSource / clearSources
  .. deprecation: v1.4.7b ..
}

class dataSourceDefinition {
  + id : double
  + type : char
  + deviceNumber : double
  .. deprecation: v1.4.7b ..
}

' ================================================================
' DATA SOURCE
' ================================================================
class dataSource {
  + id : double
  + name : char = 'DataSource0001'
  + deviceNumber : double = 1
  + rawData : rawData
  + lock : logical = true
  + activeStructured : double = 0
  - structured : cell
  + /type <<Dep>>
  + /nStructuredData <<Dep>>
  __
  + addStructuredData / removeStructuredData
  + getStructuredData / findStructuredData
  + getRawData / setRawData / clearRawData
  + lock() / unlock() / isLock()
  .. deprecation: v1.4.9 ..
}

' ================================================================
' STRUCTURED DATA HIERARCHY
' ================================================================
class structuredData {
  + id : double
  + name : char = 'StructuredData0001'
  + description : char
  + timeline : icnna.data.core.timeline
  + data : double[3D]
  + integrity : integrityStatus
  + signalTags : cell
  + /nSamples, nChannels, nSignals <<Dep>>
  __
  + crop(from, to)
  + cut(from, to)
  + getBlock / getChannel / getSignal / getSample
  + windowSelection(...)
  + checkIntegrity()
  .. deprecation: v1.4.5 ..
}

note right of structuredData
  **Cross-architecture dependency:**
  timeline property holds a modern
  icnna.data.core.timeline object.
end note

class neuroimage {
  + chLocationMap : channelLocationMap
  __
  .. deprecation: v1.4.5 ..
}

class nirs_neuroimage {
  + probeMode : char <<DEPRECATED>>
  + {static} OXY=1, DEOXY=2
  + {static} CYTOCHROME=3, TOTALHB=4, HBDIFF=5
  __
  + checkIntegrity()
  + decimate()
  + detrend()
  + detectMirroringv3()
  + detectSuddenChanges()
  + Pegna_detectOptodeMovement()
  + Sato_detectOptodeMovement()
  + doubleES()
  + mirroring()
  .. deprecation: v1.4.5 ..
}

class ecg {
  - samplingRate : double = 250
  - startTime : datevec
  - rPeaksMode : char = 'auto'
  - rPeaksAlgo : char = 'LoG'
  - threshold : double = 0
  - rPeaks : double[]
  - rr : double[]
  + /timestamps <<Dep>>
  __
  + crop / cut / getBlock
  + getBPM / getRPeaks / getRR
  + lfhfRatio / nn50 / pnn50
  + rmssd / sdann / sdnn
  + qrsdetection()
  + optimalThreshold()
  .. deprecation: v1.4.9 ..
}

' ================================================================
' SIGNAL
' ================================================================
class signal {
  + samples : double[]
  __
  + plus / minus / mtimes / mrdivide / uminus
  + ctranspose
  + filter / decimate
  + length / size / end
  + subsref / subsasgn
  .. deprecation: v1.4.5 ..
}

' ================================================================
' TIMELINE (legacy)
' ================================================================
class "timeline" as oo_timeline {
  + length : double = 0
  + startTime : datenum
  + timestamps : double[]
  + nominalSamplingRate : double = 1
  + conditions : cell
  + exclusory : double[]
  + /nConditions <<Dep>>
  + /samplingRate <<Dep>>
  __
  + addCondition / removeCondition / clearConditions
  + addConditionEvents / removeConditionEvents
  + getCondition / getConditionEvents / getConditionTag
  + setExclusory / getExclusory / setAllExclusory
  + switchExclusory
  + findCondition / getMaxEvents / getTotalEvents
  + getAvgRestTime / getAvgTaskTime
  + compatible(otherTimeline) : logical
  .. deprecation: v1.4.5 ..
  .. modern equivalent: icnna.data.core.timeline ..
}

' ================================================================
' INTEGRITY
' ================================================================
class integrityStatus {
  - elements : double[]
  + {static} UNCHECK = -1
  + {static} FINE = 0
  + {static} MISSING = 1, NOISE = 2, OTHER = 3
  + {static} MIRRORING = 11
  + {static} NONRECORDINGS = 12
  + {static} NEGATIVERECORDINGS = 13
  + {static} OPTODEMOVEMENT = 14
  + {static} HEADMOTION = 15
  + {static} COEFFICIENTOFVARIATION = 16
  __
  + getStatus / setStatus
  + getNElements / setNElements
  + isCheck / isClean
  .. deprecation: v1.5.4 ..
}

' ================================================================
' SPATIAL / CHANNEL MAPPING
' ================================================================
class channelLocationMap {
  + id, description
  + nChannels : double, nOptodes : double
  + chLocations : double[Nx3]
  + optodesLocations : double[Mx3]
  + optodesTypes : double[]
  + referencePoints : struct[]
  + surfacePositioningSystem : char = 'UI 10/10'
  + chSurfacePositions : cell
  + optodesSurfacePositions : cell
  + stereotacticPositioningSystem : char = 'MNI'
  + chStereotacticPositions : double[Nx3]
  + chProbeSets, chOptodeArrays : double[]
  + optodesProbeSets, optodesOptodeArrays : double[]
  + pairings : double[Px2]
  + optodeArrays : struct[]
  + {static} OPTODE_TYPE_UNKNOWN = 0
  + {static} OPTODE_TYPE_EMISOR = 1
  + {static} OPTODE_TYPE_DETECTOR = 2
  __
  + setChannel3DLocations / getChannel3DLocations
  + setOptode3DLocations / getOptode3DLocations
  + setChannelSurfacePositions / getChannelSurfacePositions
  + setOptodeSurfacePositions / getOptodeSurfacePositions
  + setChannelStereotacticPositions / getChannelStereotacticPositions
  + setPairings / getPairings
  + getIOD()
  + setOptodeTypes / getOptodeTypes
  + setOptodeArraysInfo / getOptodeArraysInfo
  + addReferencePoints / removeReferencePoints / getReferencePoints
  + isValidSurfacePosition()
  .. deprecation: v1.5.1 ..
}

' ================================================================
' RAW DATA HIERARCHY
' ================================================================
abstract class rawData <<abstract>> {
  + id : double
  + description : char = 'RawData0001'
  + date : datenum
  __
  + {abstract} convert()
  + {abstract} import()
  .. deprecation: v1.4.9 ..
}

